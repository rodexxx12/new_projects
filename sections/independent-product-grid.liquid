{{ 'independent-product-grid.css' | asset_url | stylesheet_tag }}

<section
  class="ipg"
  style="
    --ipg-columns: {{ section.settings.columns }};
    --ipg-gap: {{ section.settings.gap }}px;
    padding-block: {{ section.settings.padding }}px;
  "
>
  {% if section.settings.heading != blank %}
    <h2 class="ipg__heading">
      {{ section.settings.heading | escape }}
    </h2>
  {% endif %}

  <div class="ipg__grid">
    {% content_for 'blocks' %}
  </div>
</section>

{% schema %}
{
  "name": "Independent product grid",
  "blocks": [
    {
      "type": "_ipg-product"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Independent Product Grid"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Independent product grid",
      "blocks": [
        {
          "type": "_ipg-product",
          "settings": {
            "background": "#E9D7C3",
            "border_color": "#805839",
            "radius": 16
          },
          "blocks": [
            {
              "type": "ipg-content",
              "settings": {
                "kind": "image"
              }
            },
            {
              "type": "ipg-content",
              "settings": {
                "kind": "title"
              }
            },
            {
              "type": "ipg-content",
              "settings": {
                "kind": "price"
              }
            },
            {
              "type": "ipg-content",
              "settings": {
                "kind": "button"
              }
            }
          ]
        },
        {
          "type": "_ipg-product",
          "settings": {
            "background": "#FFFFFF",
            "border_width": 0,
            "radius": 0
          },
          "blocks": [
            {
              "type": "ipg-content",
              "settings": {
                "kind": "image"
              }
            },
            {
              "type": "ipg-content",
              "settings": {
                "kind": "title"
              }
            },
            {
              "type": "ipg-content",
              "settings": {
                "kind": "price"
              }
            },
            {
              "type": "ipg-content",
              "settings": {
                "kind": "button"
              }
            }
          ]
        },
        {
          "type": "_ipg-product",
          "settings": {
            "background": "#E0EBDD",
            "border_color": "#426747",
            "radius": 24
          },
          "blocks": [
            {
              "type": "ipg-content",
              "settings": {
                "kind": "image"
              }
            },
            {
              "type": "ipg-content",
              "settings": {
                "kind": "title"
              }
            },
            {
              "type": "ipg-content",
              "settings": {
                "kind": "price"
              }
            },
            {
              "type": "ipg-content",
              "settings": {
                "kind": "button"
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
