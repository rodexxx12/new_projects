<section
  id="SwiperSection-{{ section.id }}"
  class="swiper-section section section--{{ section.settings.section_width }}"
  style="--swiper-section-height: {{ section.settings.slide_height }}px;"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  <div
    class="swiper swiper-section__slider"
    data-swiper-container
    data-loop="{{ section.settings.loop }}"
    data-autoplay="{{ section.settings.autoplay }}"
    data-autoplay-delay="{{ section.settings.autoplay_delay | times: 1000 }}"
    data-speed="{{ section.settings.transition_speed }}"
  >
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="swiper-slide swiper-section__slide" {{ block.shopify_attributes }}>
          {% if block.settings.link != blank %}
            <a class="swiper-section__slide-link" href="{{ block.settings.link }}"{% if block.settings.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>
          {% endif %}

          {% if block.settings.image != blank %}
            {% assign image_loading = 'lazy' %}
            {% assign image_fetchpriority = 'auto' %}
            {% if forloop.first %}{% assign image_loading = 'eager' %}{% endif %}
            {% if forloop.first %}{% assign image_fetchpriority = 'high' %}{% endif %}
            {{ block.settings.image
              | image_url: width: 2400
              | image_tag:
                widths: '480, 750, 1100, 1500, 2000, 2400',
                sizes: '100vw',
                loading: image_loading,
                fetchpriority: image_fetchpriority,
                class: 'swiper-section__image'
            }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'swiper-section__image swiper-section__placeholder' }}
          {% endif %}

          {% if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank %}
            <div class="swiper-section__content">
              {% if block.settings.heading != blank %}
                <h2 class="swiper-section__heading">{{ block.settings.heading | escape }}</h2>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="swiper-section__text rte">{{ block.settings.text }}</div>
              {% endif %}
              {% if block.settings.button_label != blank %}
                <span class="swiper-section__button">{{ block.settings.button_label | escape }}</span>
              {% endif %}
            </div>
          {% endif %}

          {% if block.settings.link != blank %}</a>{% endif %}
        </div>
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 %}
      <button class="swiper-button-prev swiper-section__arrow" type="button" aria-label="Previous slide">
        <span aria-hidden="true">‹</span>
      </button>
      <button class="swiper-button-next swiper-section__arrow" type="button" aria-label="Next slide">
        <span aria-hidden="true">›</span>
      </button>
      <div class="swiper-pagination swiper-section__pagination" aria-label="Choose a slide"></div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .swiper-section {
    padding: 0;
  }

  .swiper-section__slider {
    height: var(--swiper-section-height, 560px);
    color: #fff;
    --swiper-theme-color: currentColor;
    --swiper-pagination-color: currentColor;
  }

  .swiper-section__slide,
  .swiper-section__slide-link {
    display: block;
    height: 100%;
  }

  .swiper-section__slide-link {
    color: inherit;
    text-decoration: none;
  }

  .swiper-section__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .swiper-section__placeholder {
    background: #ddd;
  }

  .swiper-section__slide::after {
    position: absolute;
    inset: 35% 0 0;
    background: linear-gradient(transparent, rgb(0 0 0 / 55%));
    content: '';
    pointer-events: none;
  }

  .swiper-section__content {
    position: absolute;
    z-index: 1;
    inset-inline: clamp(24px, 8vw, 120px);
    bottom: clamp(48px, 9vw, 112px);
    max-width: 720px;
  }

  .swiper-section__heading {
    margin: 0 0 12px;
    color: inherit;
    font-size: clamp(2rem, 5vw, 4.5rem);
  }

  .swiper-section__text {
    max-width: 560px;
  }

  .swiper-section__button {
    display: inline-block;
    margin-top: 20px;
    padding: 12px 20px;
    border: 1px solid currentColor;
  }

  .swiper-section__arrow {
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgb(0 0 0 / 35%);
    color: #fff;
  }

  .swiper-section__arrow span {
    font-size: 32px;
    line-height: 1;
  }

  .swiper-section__pagination {
    bottom: 20px;
  }

  @media screen and (max-width: 749px) {
    .swiper-section__slider {
      height: min(var(--swiper-section-height, 560px), 72svh);
      min-height: 360px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Swiper slideshow",
  "tag": "div",
  "class": "swiper-slideshow-section",
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Featured slides"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "full-width", "label": "Full width" },
        { "value": "page-width", "label": "Page width" }
      ],
      "default": "full-width"
    },
    {
      "type": "range",
      "id": "slide_height",
      "label": "Slide height",
      "min": 300,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 600
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop slides",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Autoplay interval",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "range",
      "id": "transition_speed",
      "label": "Transition speed",
      "min": 200,
      "max": 1200,
      "step": 100,
      "unit": "ms",
      "default": 500
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Slide heading" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share a message with your customers.</p>" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "link", "label": "Slide link" },
        { "type": "checkbox", "id": "open_in_new_tab", "label": "Open link in new tab", "default": false }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Swiper slideshow",
      "category": "Media",
      "blocks": [
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
