<div class="page-width">
  <div
    class="swiper swiper-slider"
    id="swiper-{{ section.id }}"
    style="
      --ss-padding-top: {{ section.settings.padding_top }}px;
      --ss-padding-bottom: {{ section.settings.padding_bottom }}px;
      --ss-height: {{ section.settings.slide_height }}px;
      --ss-radius: {{ section.settings.corner_radius }}px;
      --ss-arrow-color: {{ section.settings.arrow_color }};
      --ss-dot-color: {{ section.settings.dot_color }};
      --ss-text-color: {{ section.settings.text_color }};
      --ss-overlay: {{ section.settings.overlay | divided_by: 100.0 }};
    "
    data-autoplay="{{ section.settings.autoplay }}"
    data-delay="{{ section.settings.autoplay_delay }}"
    data-loop="{{ section.settings.loop }}"
    data-speed="{{ section.settings.speed }}"
    data-effect="{{ section.settings.effect }}"
    data-desktop="{{ section.settings.slides_desktop }}"
    data-mobile="{{ section.settings.slides_mobile }}"
    data-space="{{ section.settings.space_between }}"
    data-arrows="{{ section.settings.show_arrows }}"
    data-pagination="{{ section.settings.pagination_type }}"
  >
    <div class="swiper-wrapper">
      {%- for block in section.blocks -%}
        {%- render 'swiper-slide', block: block -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_arrows -%}
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
    {%- endif -%}

    {%- if section.settings.pagination_type != 'none' -%}
      <div class="swiper-pagination"></div>
    {%- endif -%}
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
<script src="{{ 'swiper-slider.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Swiper Slider",
  "settings": [
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": true }
  ],
  "presets": [{ "name": "Swiper Slider" }]
}
{% endschema %}