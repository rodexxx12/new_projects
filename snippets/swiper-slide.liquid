{%- comment -%}
  Renders one slide.
  Accepts: block (the section block object)
{%- endcomment -%}

{%- liquid
  assign slide_image = block.settings.image
  assign mobile_image = block.settings.mobile_image
  assign overlay_opacity = block.settings.overlay_opacity | divided_by: 100.0
  assign text_alignment = block.settings.text_alignment | default: 'left'
  assign text_position = block.settings.text_position | default: 'center'
  assign img_loading = 'lazy'
  if eager
    assign img_loading = 'eager'
  endif
-%}

<div
  class="swiper-slide"
  {{ block.shopify_attributes }}
  data-text-alignment="{{ text_alignment }}"
  style="--slide-text-alignment: {{ text_alignment }}; --slide-text-color: {{ block.settings.text_color | default: section.settings.text_color }}; --slide-overlay-color: {{ block.settings.overlay_color | default: '#000000' }}; --slide-overlay-opacity: {{ overlay_opacity | default: 0.25 }};"
>
  <div class="swiper-slide__inner">
    {%- if slide_image != blank -%}
      <picture class="swiper-slide__picture">
        {%- if mobile_image != blank -%}
          <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 1000 }}">
        {%- endif -%}
        {{ slide_image | image_url: width: 2400 | image_tag: class: 'swiper-slide__image', loading: img_loading, widths: '400, 800, 1200, 1600, 2000, 2400' }}
      </picture>
    {%- else -%}
      <div class="swiper-slide__placeholder">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {%- endif -%}

    <div class="swiper-slide__overlay" aria-hidden="true"></div>

    {%- if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank -%}
      <div class="swiper-slide__content swiper-slide__content--{{ text_position }}">
        {%- if block.settings.heading != blank -%}
          <h2 class="swiper-slide__heading">{{ block.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <div class="swiper-slide__text">{{ block.settings.text | escape | newline_to_br }}</div>
        {%- endif -%}
        {%- if block.settings.button_label != blank -%}
          {%- if block.settings.button_link != blank -%}
            <a class="swiper-slide__button" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>
          {%- else -%}
            <span class="swiper-slide__button">{{ block.settings.button_label | escape }}</span>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>
