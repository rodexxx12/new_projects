{% comment %}
  Individual Product Card Override
  Applies settings only to the selected product
  inside this instance of Product list.
{% endcomment %}

{% liquid
  assign override_product = block.settings.product
  assign override_ratio = '1'

  if block.settings.media_image_ratio == 'landscape'
    assign override_ratio = '16 / 9'
  elsif block.settings.media_image_ratio == 'portrait'
    assign override_ratio = '4 / 5'
  elsif block.settings.media_image_ratio == 'square'
    assign override_ratio = '1'
  elsif block.settings.media_image_ratio == 'adapt'
    assign override_ratio = override_product.featured_media.preview_image.aspect_ratio | default: 1
  endif
%}

{% if override_product != blank %}
  {% capture card_selector %}
    #shopify-section-{{ section.id }}
    product-card[data-product-id="{{ override_product.id }}"]
  {% endcapture %}
  {% assign card_selector = card_selector | strip %}

  <style>
    /* Individual product card appearance */

    {{ card_selector }} > .product-card__content {
      {% if block.settings.background_color != blank %}
        background-color:
          {{ block.settings.background_color }} !important;
      {% endif %}

      border-radius:
        {{ block.settings.border_radius }}px !important;

      overflow: hidden;

      {% case block.settings.shadow %}
        {% when 'soft' %}
          box-shadow:
            0 5px 16px rgb(0 0 0 / 0.10) !important;
        {% when 'strong' %}
          box-shadow:
            0 12px 30px rgb(0 0 0 / 0.20) !important;
        {% else %}
          box-shadow: none !important;
      {% endcase %}
    }

    /* Individual product visibility */

    {% unless block.settings.show_price %}
      {{ card_selector }} product-price {
        display: none !important;
      }
    {% endunless %}

    {% unless block.settings.show_title %}
      {{ card_selector }} [ref="productTitleLink"],
      {{ card_selector }} .product-grid-view-zoom-out--details {
        display: none !important;
      }
    {% endunless %}

    {% unless block.settings.show_media %}
      {{ card_selector }} .card-gallery {
        display: none !important;
      }
    {% endunless %}

    {% unless block.settings.show_quick_add %}
      {{ card_selector }} quick-add-component {
        display: none !important;
      }
    {% endunless %}

    {% unless block.settings.show_badges %}
      {{ card_selector }} .product-badges {
        display: none !important;
      }
    {% endunless %}

    {% unless block.settings.show_swatches %}
      {{ card_selector }} product-swatches,
      {{ card_selector }} swatches-variant-picker-component {
        display: none !important;
      }
    {% endunless %}

    {% unless block.settings.show_reviews %}
      {{ card_selector }} .rating-wrapper {
        display: none !important;
      }
    {% endunless %}

    {% unless block.settings.show_sku %}
      {{ card_selector }} product-sku-component {
        display: none !important;
      }
    {% endunless %}

    {% unless block.settings.show_buy_buttons %}
      {{ card_selector }} .buy-buttons-block {
        display: none !important;
      }
    {% endunless %}

    /* Individual card border */

    {% if block.settings.override_card_border %}
      {{ card_selector }} > .product-card__content {
        border-style:
          {{ block.settings.card_border_style }} !important;

        border-width:
          {{ block.settings.card_border_width }}px !important;

        border-color:
          {{ block.settings.card_border_color }} !important;
      }
    {% endif %}

    /* Individual card padding */

    {% if block.settings.override_card_padding %}
      {{ card_selector }} > .product-card__content {
        padding-block-start:
          {{ block.settings.card_padding_top }}px !important;

        padding-block-end:
          {{ block.settings.card_padding_bottom }}px !important;

        padding-inline-start:
          {{ block.settings.card_padding_left }}px !important;

        padding-inline-end:
          {{ block.settings.card_padding_right }}px !important;
      }
    {% endif %}

    /* Individual hover animation */

    @media (hover: hover) and (prefers-reduced-motion: no-preference) {

      {% if block.settings.hover_effect == 'lift' %}
        {{ card_selector }} {
          transition: transform 200ms ease;
        }

        {{ card_selector }}:hover {
          transform: translateY(-5px);
        }

      {% elsif block.settings.hover_effect == 'scale' %}
        {{ card_selector }} {
          transition: transform 200ms ease;
        }

        {{ card_selector }}:hover {
          transform: scale(1.02);
        }
      {% endif %}

    }

    /* Individual media appearance */

    {% if block.settings.media_override_enabled %}
      {{ card_selector }} .card-gallery {
        --gallery-aspect-ratio:
          {{ override_ratio }} !important;

        --border-style:
          {{ block.settings.media_border }} !important;

        --border-width:
          {{ block.settings.media_border_width }}px !important;

        --border-color:
          {{ block.settings.media_border_color }} !important;

        --border-radius:
          {{ block.settings.media_radius }}px !important;

        --padding-block-start:
          {{ block.settings.media_padding_top }}px !important;

        --padding-block-end:
          {{ block.settings.media_padding_bottom }}px !important;

        --padding-inline-start:
          {{ block.settings.media_padding_left }}px !important;

        --padding-inline-end:
          {{ block.settings.media_padding_right }}px !important;

        overflow: clip;
      }
    {% endif %}
  </style>

  {% if request.design_mode %}
    <span
      hidden
      data-override-product="{{ override_product.id }}"
      {{ block.shopify_attributes }}
    ></span>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Card override",
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product to customize"
    },
    {
      "type": "header",
      "content": "Visibility for this product"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_media",
      "label": "Show product media",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show product badges",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "Show swatches",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show reviews",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "label": "Show SKU",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_buy_buttons",
      "label": "Show buy buttons",
      "default": true
    },
    {
      "type": "header",
      "content": "Individual card border"
    },
    {
      "type": "checkbox",
      "id": "override_card_border",
      "label": "Override card border",
      "default": false
    },
    {
      "type": "select",
      "id": "card_border_style",
      "label": "Border style",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "solid", "label": "Solid" },
        { "value": "dashed", "label": "Dashed" }
      ],
      "default": "solid",
      "visible_if": "{{ block.settings.override_card_border }}"
    },
    {
      "type": "range",
      "id": "card_border_width",
      "label": "Border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.override_card_border }}"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Border color",
      "default": "#DDDDDD",
      "visible_if": "{{ block.settings.override_card_border }}"
    },
    {
      "type": "header",
      "content": "Individual card padding"
    },
    {
      "type": "checkbox",
      "id": "override_card_padding",
      "label": "Override card padding",
      "default": false
    },
    {
      "type": "range",
      "id": "card_padding_top",
      "label": "Top",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.override_card_padding }}"
    },
    {
      "type": "range",
      "id": "card_padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.override_card_padding }}"
    },
    {
      "type": "range",
      "id": "card_padding_left",
      "label": "Left",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.override_card_padding }}"
    },
    {
      "type": "range",
      "id": "card_padding_right",
      "label": "Right",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.override_card_padding }}"
    },
    {
      "type": "header",
      "content": "Hover effect"
    },
    {
      "type": "select",
      "id": "hover_effect",
      "label": "Effect",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "lift", "label": "Lift" },
        { "value": "scale", "label": "Scale" }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Card background"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "shadow",
      "label": "Card shadow",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "soft",
          "label": "Soft"
        },
        {
          "value": "strong",
          "label": "Strong"
        }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "paragraph",
      "content": "Displays media from the selected parent product."
    },
    {
      "type": "checkbox",
      "id": "media_override_enabled",
      "label": "Override media settings",
      "default": false
    },
    {
      "type": "select",
      "id": "media_image_ratio",
      "label": "Aspect ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Auto"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ],
      "default": "adapt",
      "info": "Adjusted in some layouts."
    },
    {
      "type": "header",
      "content": "Media borders"
    },
    {
      "type": "select",
      "id": "media_border",
      "label": "Style",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "solid",
          "label": "Solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "media_border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "media_border_color",
      "label": "Border color",
      "default": "#DDDDDD"
    },
    {
      "type": "range",
      "id": "media_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Media padding"
    },
    {
      "type": "range",
      "id": "media_padding_top",
      "label": "Top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "media_padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "media_padding_left",
      "label": "Left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "media_padding_right",
      "label": "Right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Card override"
    }
  ]
}
{% endschema %}
